<ui:FluentWindow
    x:Class="Mageki.WPF.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Mageki Settings"
    Width="520"
    Height="620"
    MinWidth="420"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar
            Grid.Row="0"
            x:Name="SettingsTitleBar"
            Title="Mageki Settings"
            ShowMinimize="False"
            ShowMaximize="False"
            ShowClose="True"
            ShowHelp="False"
            ForceShutdown="False"/>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="Connection"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Port"
                               VerticalAlignment="Center"
                               Margin="0,6"/>
                    <ui:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        x:Name="PortBox"
                        Width="100"
                        HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1"
                               Text="Protocol"
                               VerticalAlignment="Center"
                               Margin="0,6"/>
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal">
                        <RadioButton
                            x:Name="TcpRadio"
                            Content="TCP"
                            Margin="0,6,16,6"
                            Checked="Protocol_Checked"/>
                        <RadioButton x:Name="UdpRadio"
                                     Content="UDP"
                                     Margin="0,6"
                                     Checked="Protocol_Checked"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Text="IP address"
                               VerticalAlignment="Center"
                               Margin="0,6"/>
                    <ui:TextBox Grid.Row="2"
                                Grid.Column="1"
                                x:Name="IpBox"
                                Margin="0,3"/>
                    <TextBlock Grid.Row="3"
                               Text="Status"
                               VerticalAlignment="Center"
                               Margin="0,6"/>
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Margin="0,6"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Canvas theme"
                               VerticalAlignment="Center"/>
                    <ComboBox
                        Grid.Column="1"
                        x:Name="CanvasThemeCombo"
                        Width="120"
                        HorizontalAlignment="Left"
                        SelectionChanged="CanvasTheme_Changed">
                        <ComboBoxItem Content="Auto"
                                      Tag="Auto"/>
                        <ComboBoxItem Content="Light"
                                      Tag="Light"/>
                        <ComboBoxItem Content="Dark"
                                      Tag="Dark"/>
                    </ComboBox>
                </Grid>

                <TextBlock Text="Keyboard"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ui:ToggleSwitch
                    x:Name="HideButtonsCheck"
                    Content="Hide game buttons"
                    Margin="0,5"
                    Checked="Setting_Changed"
                    Unchecked="Setting_Changed"/>
                <Grid Margin="0,5,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Button bottom margin"
                               VerticalAlignment="Center"/>
                    <Slider
                        Grid.Column="1"
                        x:Name="BottomMarginSlider"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="BottomMargin_Changed"/>
                    <TextBlock
                        Grid.Column="2"
                        x:Name="BottomMarginText"
                        TextAlignment="Right"
                        VerticalAlignment="Center"/>
                </Grid>
                <ui:ToggleSwitch
                    x:Name="AntiMisTouchCheck"
                    Content="Anti-mistouch"
                    Margin="0,5"
                    Checked="Setting_Changed"
                    Unchecked="Setting_Changed"/>

                <TextBlock
                    Text="Lever and side buttons"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,12,0,8"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,0,10">
                    <TextBlock Text="Movement mode"
                               Width="150"
                               VerticalAlignment="Center"/>
                    <RadioButton
                        x:Name="RelativeRadio"
                        Content="Relative"
                        Margin="0,0,16,0"
                        Checked="LeverMode_Checked"/>
                    <RadioButton x:Name="AbsoluteRadio"
                                 Content="Absolute"
                                 Checked="LeverMode_Checked"/>
                </StackPanel>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lever linearity"
                               VerticalAlignment="Center"/>
                    <Slider
                        Grid.Column="1"
                        x:Name="LinearitySlider"
                        Minimum="54"
                        Maximum="540"
                        ValueChanged="Linearity_Changed"/>
                    <TextBlock
                        Grid.Column="2"
                        x:Name="LinearityText"
                        TextAlignment="Right"
                        VerticalAlignment="Center"/>
                </Grid>
                <ui:ToggleSwitch
                    x:Name="OverflowCheck"
                    Content="Handle lever overflow"
                    Margin="0,5"
                    Checked="Setting_Changed"
                    Unchecked="Setting_Changed"/>
                <ui:ToggleSwitch
                    x:Name="CompositeCheck"
                    Content="Merge lever and side buttons"
                    Margin="0,5"
                    Checked="Setting_Changed"
                    Unchecked="Setting_Changed"/>

                <TextBlock Text="Other"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,16,0,8"/>
                <ui:ToggleSwitch
                    x:Name="HapticCheck"
                    Content="Enable haptic feedback"
                    Margin="0,5"
                    Checked="Setting_Changed"
                    Unchecked="Setting_Changed"/>
                <Grid Margin="0,5,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Aime ID"
                               VerticalAlignment="Center"/>
                    <ui:TextBox Grid.Column="1"
                                x:Name="AimeBox"
                                MaxLength="20"/>
                </Grid>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <ui:Button Content="Save"
                               Width="90"
                               IsDefault="True"
                               Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
